# Скопіюйте в .env (файл .env у git НЕ комітимо)
MASTODON_INSTANCE=https://mastodon.social
# Токени необов'язкові (публічні таймлайни читаються без них). Кілька через кому -> ротація при 429.
MASTODON_TOKENS=
HASHTAGS=python,opensource,linux
PAGES_PER_RUN=5
PAGE_LIMIT=40
REQUEST_DELAY=1.5
MAX_RETRIES=6
DB_PATH=data/collector.db
# Необов'язково: проксі для виходу, напр. http://user:pass@host:3128
HTTP_PROXY_URL=
